# LaunchDarkly Configuration (Required)
LAUNCHDARKLY_ENABLED=true
LAUNCHDARKLY_SDK_KEY=sdk-your-sdk-key-here
LAUNCHDARKLY_PROJECT_KEY=your-project-key
LAUNCHDARKLY_ACCESS_TOKEN=api-your-access-token-here

# LaunchDarkly environment key. Drives backend observability tagging AND the
# Terraform target_environment (where each AI Config's default rule is turned on).
LAUNCHDARKLY_ENVIRONMENT=test

# Non-production LaunchDarkly instance (e.g. staging). Leave all unset for production.
# LAUNCHDARKLY_API_HOST is used by Terraform and scripts/set_ai_config_targeting.py;
# the *_URI values configure the backend SDK. ENV_FILE is the file docker compose
# mounts into the backend; set it when using --env-file with a non-default file.
# The <...> hosts are placeholders: LaunchDarkly staff can get the staging values from the evals team.
# LAUNCHDARKLY_API_HOST=https://<launchdarkly-host>
# LAUNCHDARKLY_STREAM_URI=https://<stream-host>
# LAUNCHDARKLY_EVENTS_URI=https://<events-host>
# Where the observability plugin sends traces (OTLP gRPC) and reads its sampling config.
# LAUNCHDARKLY_OTLP_ENDPOINT=https://<otel-host>:4317
# LAUNCHDARKLY_OBSERVABILITY_BACKEND_URL=https://<observability-backend-host>
# OpenClaw's exporter (openclaw/env.sh) uses OTLP/HTTP instead.
# LAUNCHDARKLY_OTLP_HTTP_ENDPOINT=https://<otel-host>:4318
# ENV_FILE=./.env.staging-org
# Terraform state workspace for this instance ("default" is production).
# TF_WORKSPACE=staging

# Demo Configuration
# Display name for the demo user (backend + UI). Set to your name for demos.
DEMO_USER_NAME=Demo User

# LLM Provider Configuration
LLM_PROVIDER=bedrock
LLM_MODEL=claude-3-5-sonnet

# AWS Configuration (for Bedrock)
AWS_REGION=us-east-1
AWS_PROFILE=default

# TypeSafe Jev (optional). Needed only when triage_agent serves the jev-choice
# variation; without it, Jev triage escalates every query and sends triage-error.
TYPESAFE_API_KEY=

# OpenAI-compatible providers (optional). A variation whose model config's
# provider is OpenRouter or vLLM reaches that endpoint with these; URLs and keys
# never live in LaunchDarkly. A model config's custom params can name other env
# vars (base_url_env, api_key_env), e.g. for a second vLLM server.
# OpenRouter: needed only for triage_agent's mistral-large-4-* variations.
# Prompts sent there leave AWS (OpenRouter forwards them to Mistral): demo data only.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# vLLM: the server's OpenAI-compatible base URL, e.g. http://<host>:8000/v1
VLLM_BASE_URL=
# Only if the server was started with --api-key
VLLM_API_KEY=
