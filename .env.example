# LaunchDarkly Configuration (Required)
LAUNCHDARKLY_ENABLED=true
LAUNCHDARKLY_SDK_KEY=sdk-your-sdk-key-here
LAUNCHDARKLY_PROJECT_KEY=your-project-key
LAUNCHDARKLY_ACCESS_TOKEN=api-your-access-token-here

# LaunchDarkly environment key. Drives backend observability tagging AND the
# Terraform target_environment (where each AI Config's default rule is turned on).
LAUNCHDARKLY_ENVIRONMENT=test

# Demo Configuration
# Display name for the demo user (backend + UI). Set to your name for demos.
DEMO_USER_NAME=Demo User

# LLM Provider Configuration
LLM_PROVIDER=bedrock
LLM_MODEL=claude-3-5-sonnet

# AWS Configuration (for Bedrock)
AWS_REGION=us-east-1
AWS_PROFILE=default
